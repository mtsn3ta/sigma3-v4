# Port dan host sidecar (Gunakan 3001 agar tidak bentrok dengan nestathletics di 3000)
PORT=3001
HOST=127.0.0.1

# Token keamanan Bearer (samakan dengan WHATSAPP_WEB_TOKEN di Laravel .env)
WHATSAPP_WEB_TOKEN=Killdisk_7

# Secret Webhook untuk validasi kirim pesan ke Laravel (samakan dengan WHATSAPP_WEB_WEBHOOK_SECRET)
WHATSAPP_WEB_WEBHOOK_SECRET=Killdisk_7

# URL Webhook tujuan di Laravel
WHATSAPP_WEBHOOK_URL=https://sigma3.mtsn3tulungagung.sch.id/api/whatsapp-webhook

# Path Chromium jika menggunakan browser sistem di Linux (opsional)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
